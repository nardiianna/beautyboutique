fn();} else {document.addEventListener('DOMContentLoaded',fn);} }\n  ready(function(){\n    var toggle = document.getElementById('mobile-menu-toggle');\n    var panel = document.getElementById('mobile-nav-panel');\n    if(!toggle || !panel) return;\n    toggle.addEventListener('click', function(){\n      var open = panel.classList.toggle('open');\n      toggle.setAttribute('aria-expanded', open);\n    });\n    panel.querySelectorAll('a').forEach(function(a){\n      a.addEventListener('click', function(){\n        panel.classList.remove('open');\n        toggle.setAttribute('aria-expanded','false');\n      });\n    });\n  });\n})();\n</script>", "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "-20", "left": "0", "isLinked": false}}, "elements": []}]}, {"id": "d3dc622", "elType": "column", "settings": {"_column_size": 50, "content_position": "center", "_element_id": "primary-nav-col"}, "elements": [{"id": "a1daa93", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<div style=\"margin:0;\"><nav style=\"display:flex;gap:26px;flex-wrap:wrap;justify-content:center;\"><a href=\"/#home\" style=\"color:#6E5D49;font-family:'Jost',sans-serif;font-size:12.5px;letter-spacing:.09em;text-transform:uppercase;font-weight:500;text-decoration:none;\">Home</a><a href=\"/trattamenti/\" style=\"color:#6E5D49;font-family:'Jost',sans-serif;font-size:12.5px;letter-spacing:.09em;text-transform:uppercase;font-weight:500;text-decoration:none;\">Trattamenti</a><a href=\"/il-centro/\" style=\"color:#6E5D49;font-family:'Jost',sans-serif;font-size:12.5px;letter-spacing:.09em;text-transform:uppercase;font-weight:500;text-decoration:none;\">Il Centro</a><a href=\"/#prodotti\" style=\"color:#6E5D49;font-family:'Jost',sans-serif;font-size:12.5px;letter-spacing:.09em;text-transform:uppercase;font-weight:500;text-decoration:none;\">Prodotti</a><a href=\"/contatti/\" style=\"color:#6E5D49;font-family:'Jost',sans-serif;font-size:12.5px;letter-spacing:.09em;text-transf